        "cpe:2.3:a:tukaani:xz:5.6.1:*:*:*:*:*:*:*"
      ],
      "references": [
        {
          "name": "NIST NVD Advisory",
          "url": "https://nvd.nist.gov/vuln/detail/CVE-2024-3094"
        },
        {
