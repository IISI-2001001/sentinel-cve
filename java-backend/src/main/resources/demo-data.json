  "tickets": [
    {
      "id": "tkt-1",
      "ticketNo": "TKT-PRJ-BANK-2026-001",
      "projectId": "prj-1",
      "projectCode": "PRJ-BANK-PAY",
      "projectName": "行動銀行與線上支付服務專案",
      "department": "數位金融事業群",
      "title": "【緊急修補】Linux Kernel 供應鏈與 OpenSSL TLS 安全威脅重構單",
      "priority": "CRITICAL",
      "status": "OPEN",
      "assigneeName": "陳國豪 (DevSecOps Leader)",
      "assigneeEmail": "kh.chen@bank.com.tw",
      "affectedProducts": [
        "Linux Kernel",
        "OpenSSL",
        "Nginx"
      ],
      "cveCount": 2,
      "cveList": [
        {
          "cveId": "CVE-2024-3094",
          "title": "XZ Utils / Linux Kernel SSHd 遠端碼執行後門漏洞",
          "cvss": 10,
          "severity": "CRITICAL",
          "cisaKev": true,
          "productName": "Linux Kernel"
        },
        {
          "cveId": "CVE-2024-0553",
          "title": "OpenSSL PKCS#7 記憶體緩衝區溢位漏洞",
          "cvss": 8.1,
          "severity": "HIGH",
          "cisaKev": false,
          "productName": "OpenSSL"
        }
      ],
      "slaHours": 24,
      "slaDeadline": "2026-08-21T04:44:26.633Z",
      "aiModelUsed": "gemini-3.6-flash",
      "executiveSummary": "本專案綁定之「Linux Kernel」與「OpenSSL」經 AI 評估發現包含 CVE-2024-3094 (CVSS 10.0，已被 CISA 列入 KEV) 等重大威脅。攻擊者可利用後門繞過 SSH 身份驗證，取得金流伺服器最高存取權限。必須於 24 小時內完成版號升級與重構驗證。",
      "rootCauseAnalysis": "因作業系統底層系統庫 liblzma/xz-utils 於建置階段被植入惡意混淆代碼，導致 SSHd 服務載入該 shared library 時掛鉤 RSA 解密邏輯，進而造成非授權遠端程式碼執行。",
      "actionSteps": [
        {
          "stepNumber": 1,
          "title": "確認 Linux 發行版與 xz/liblzma 版本狀態",
          "detail": "登入受影響之線上金流 Node，執行以下指令確認是否包含受污染之 5.6.0 或 5.6.1 版本：",
          "commandSnippet": "xz --version\napt list --installed | grep liblzma"
        },
        {
          "stepNumber": 2,
          "title": "降級或升級 xz-utils / liblzma 至安全版本",
          "detail": "立即將 xz-utils 降級至 5.4.6 或升級至官方緊急釋出之 5.6.2+ 安全修補套件：",
          "commandSnippet": "sudo apt-get update && sudo apt-get install --only-upgrade xz-utils liblzma5"
        },
        {
          "stepNumber": 3,
          "title": "升級 OpenSSL 基礎函式庫並重啟 SSL/TLS 端點",
          "detail": "更新 OpenSSL 至 3.0.13+ 或 3.2.1+ 以解決 PKCS#7 溢位漏洞：",
          "commandSnippet": "sudo apt-get install --only-upgrade openssl libssl-dev\nsudo systemctl restart nginx"
        },
        {
          "stepNumber": 4,
          "title": "執行金流 API 與 SSH 安全迴歸測試",
          "detail": "呼叫測試腳本確認線上支付 Gateway 憑證鏈合法性及 SSH key 存取正常。",
          "commandSnippet": "curl -Iv https://pay-gateway.bank.com.tw/health"
        }
      ],
      "mitigationPlan": "如暫時無法立即重新重構 OS，請於 API Gateway 前端 WAF 啟用 SSH/TLS 封包深層檢查，並僅對內部堡壘機 (Bastion Host) 開放 22/tcp 埠。",
      "verificationMethod": "1. 執行 `xz --version` 確保不為 5.6.0/5.6.1。\n2. 使用 OpenVAS / Nessus 進行自動掃描複查。\n3. 確認產出安全綠燈報告後簽核關閉工單。",
      "createdAt": "2026-08-20T04:44:26.633Z",
      "updatedAt": "2026-08-20T07:44:26.633Z"
    },
    {
      "id": "tkt-2",
      "ticketNo": "TKT-PRJ-CLOUD-2026-002",
      "projectId": "prj-2",
      "projectCode": "PRJ-CLOUD-CORE",
      "projectName": "企業微服務與 K8s 雲原生平台",
      "department": "資訊營運處 - 雲端架構組",
      "title": "【高危處置】Docker Engine / runC 容器逃逸漏洞緊急防護工單",
      "priority": "HIGH",
      "status": "IN_PROGRESS",
      "assigneeName": "張雅婷 (Cloud Architect Lead)",
      "assigneeEmail": "yt.chang@company.internal",
      "affectedProducts": [
        "Docker Engine",
        "Kubernetes"
      ],
      "cveCount": 1,
      "cveList": [
        {
          "cveId": "CVE-2024-21626",
          "title": "runC 容器逃逸與宿主機檔案系統越界存取漏洞 (Leaky Vessels)",
          "cvss": 8.6,
          "severity": "HIGH",
          "cisaKev": true,
          "productName": "Docker Engine"
        }
      ],
      "slaHours": 72,
      "slaDeadline": "2026-08-22T08:44:26.633Z",
      "aiModelUsed": "gemini-3.6-flash",
      "executiveSummary": "K8s 叢集 Worker Node 上的 runC 存在工作目錄 file descriptor 洩漏瑕疵。攻擊者若於 Pod 內建立惡意的 WORKDIR 指向 `/proc/self/fd/`，可在容器啟動時突破隔離層並寫入 Node 宿主機根檔案系統。",
      "rootCauseAnalysis": "runc exec 或 runc create 期間，process 在套用 cgroup 與 pivot_root 前未關閉內部系統 FD，致使子處理程序保留了宿主機目錄 FD 控制權。",
      "actionSteps": [
        {
          "stepNumber": 1,
          "title": "驅逐 Pod 並切換 K8s 節點至 Maintenance Mode",
          "detail": "對目標 Worker Node 執行 drain 指令以移轉 Pod：",
          "commandSnippet": "kubectl drain node-01.k8s.internal --ignore-daemonsets --delete-emptydir-data"
        },
        {
          "stepNumber": 2,
          "title": "更新 containerd / runc 執行階段套件",
          "detail": "將 runc 升級至 1.1.12+，containerd 升級至 1.6.28+：",
          "commandSnippet": "sudo apt-get install --only-upgrade runc containerd.io\nrunc --version"
        },
        {
          "stepNumber": 3,
          "title": "解除 Cordon 並復原 K8s 節點調度",
          "detail": "確認 runc 版本修補無誤後恢復節點運作：",
          "commandSnippet": "kubectl uncordon node-01.k8s.internal"
        }
      ],
      "mitigationPlan": "透過 AppArmor 或 Seccomp profile 阻斷 Pod 對 `/proc/self/fd/` 屬性之異動，並落實 PodSecurityPolicy 非 root 容器政策。",
      "verificationMethod": "使用 Trivy 或 Falco 檢測 K8s 節點，驗證 runc 逃逸 PoC 測試無法寫入 /host-root 目錄。",
      "createdAt": "2026-08-19T20:44:26.633Z",
      "updatedAt": "2026-08-20T06:44:26.633Z"
    }
  ]
}
